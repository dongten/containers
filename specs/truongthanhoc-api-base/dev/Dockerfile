FROM node:20-alpine AS base

LABEL org.opencontainers.image.source="https://github.com/dongten/containers"

RUN apk update && apk add --no-cache build-base gcc autoconf automake zlib-dev libpng-dev nasm bash vips-dev git
ARG NODE_ENV=production
ARG APP_KEYS
ARG API_TOKEN_SALT
ARG ADMIN_JWT_SECRET
ARG TRANSFER_TOKEN_SALT
ARG ENCRYPTION_KEY
ARG DATABASE_CLIENT
ARG DATABASE_HOST
ARG DATABASE_PORT
ARG DATABASE_NAME
ARG DATABASE_USERNAME
ARG DATABASE_PASSWORD
ARG DATABASE_SSL
ARG JWT_SECRET
ARG CLOUDINARY_NAME
ARG CLOUDINARY_KEY
ARG CLOUDINARY_SECRET

ENV NODE_ENV=${NODE_ENV}
ENV PATH=/app/node_modules/.bin:$PATH

ENV TZ="Asia/Ho_Chi_Minh"
ENV HOST="0.0.0.0"
ENV PORT="1337"
ENV APP_KEYS=${APP_KEYS}
ENV API_TOKEN_SALT=${API_TOKEN_SALT}
ENV ADMIN_JWT_SECRET=${ADMIN_JWT_SECRET}
ENV TRANSFER_TOKEN_SALT=${TRANSFER_TOKEN_SALT}
ENV ENCRYPTION_KEY=${ENCRYPTION_KEY}
ENV DATABASE_CLIENT=${DATABASE_CLIENT:-postgres}
ENV DATABASE_HOST=${DATABASE_HOST:-localhost}
ENV DATABASE_PORT=${DATABASE_PORT:-5432}
ENV DATABASE_NAME=${DATABASE_NAME:-truongthanhoc_db}
ENV DATABASE_USERNAME=${DATABASE_USERNAME:-truongthanhoc_user}
ENV DATABASE_PASSWORD=${DATABASE_PASSWORD:-truongthanhoc_pass}
ENV DATABASE_SSL=${DATABASE_SSL:-true}
ENV JWT_SECRET=${JWT_SECRET}
ENV CLOUDINARY_NAME=${CLOUDINARY_NAME}
ENV CLOUDINARY_KEY=${CLOUDINARY_KEY}
ENV CLOUDINARY_SECRET=${CLOUDINARY_SECRET}

VOLUME ["/app"]

WORKDIR /app

EXPOSE 1337

CMD ["npm", "run", "start"]
